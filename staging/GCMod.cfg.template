; This code default is not proof of an approved Medium bundle. For a trial, set
; the existing approved RHR_Medium_GFSAFE_ADH custody path listed in EXTERNAL_DEPENDENCIES_KO.md.
; Do not copy this template over unrelated personal configuration.
[Translation.Font]
AssetBundlePath = GCMod/fonts/tsukuardgothic-std-medium

; Operator assertion only; this template does not configure an XUnity plugin.
[Staging]
XUnityEnabled = false
