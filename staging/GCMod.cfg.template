[Nextgen]
Enabled = false
PackageRoot = GCMod.Nextgen.Candidate/translations/ko
ReloadPackage = false
UiRequestsEnabled = false
CheckUpdate = false
UpdateRepository = kekwkekw/gctrans
UpdateChannel = main

[Translation]
Enabled = true
Language = ko

