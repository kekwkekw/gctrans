{
  "$id": "urn:gc:ui:bindings:ng01-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded read-only selectors. Compiled adapters own scope/slot and native compatibility. Unknown optional adapters are unavailable, never executable declarations.",
  "properties": {
    "bindings": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "selector": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "group_id"
                        ]
                      },
                      {
                        "required": [
                          "script_id"
                        ]
                      },
                      {
                        "required": [
                          "branch_label"
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "if": {
              "properties": {
                "source_identity": {
                  "properties": {
                    "kind": {
                      "const": "choice-group"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "selector": {
                  "required": [
                    "group_id",
                    "script_id",
                    "branch_label"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "action_group"
              ]
            },
            "then": {
              "properties": {
                "adapter_id": {
                  "enum": [
                    "core.static-caption.v1",
                    "ui4.static-caption.v1"
                  ]
                },
                "source_identity": {
                  "properties": {
                    "kind": {
                      "const": "static-asset"
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "action_group": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "adapter_id": {
            "description": "Format only; unknown or unsupported optional adapters are unavailable capabilities. Structural validity remains independent of native availability.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "resource_id": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "selector": {
            "additionalProperties": false,
            "description": "Only bounded literal selector data. Code-owned adapters define the allowed scope and slot. Choice fields are read-only matching facts.",
            "properties": {
              "branch_label": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "domain": {
                "maximum": 65535,
                "minimum": -1,
                "type": "integer"
              },
              "group_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "lifetime": {
                "enum": [
                  "callback",
                  "owner",
                  "cell"
                ]
              },
              "overflow_policy": {
                "enum": [
                  "intrinsic-only"
                ]
              },
              "scope_key": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "type": "string"
              },
              "script_id": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "segments": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000-\\u001f\\u007f*?]+$",
                  "type": "string"
                },
                "maxItems": 32,
                "minItems": 1,
                "type": "array"
              },
              "selected": {
                "type": "boolean"
              },
              "slot_key": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "type": "string"
              },
              "source_id": {
                "maximum": 65535,
                "minimum": -1,
                "type": "integer"
              },
              "source_value": {
                "maximum": 65535,
                "minimum": -1,
                "type": "integer"
              },
              "template_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "static",
                  "model",
                  "control",
                  "date",
                  "profile",
                  "exchange",
                  "caption"
                ]
              }
            },
            "required": [
              "scope_key",
              "slot_key"
            ],
            "type": "object"
          },
          "source_identity": {
            "additionalProperties": false,
            "description": "Original source identity is opaque data. It is never an executable address, native pointer, code pin, or hook declaration.",
            "properties": {
              "exact_jp": {
                "maxLength": 16384,
                "minLength": 1,
                "pattern": "^[^\\u0000]*$",
                "type": "string"
              },
              "identity": {
                "oneOf": [
                  {
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "items": {
                      "oneOf": [
                        {
                          "maxLength": 2048,
                          "type": "string"
                        },
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "maxItems": 16,
                    "minItems": 1,
                    "type": "array"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "static-asset",
                  "current-model",
                  "choice-group",
                  "native-template"
                ]
              }
            },
            "required": [
              "kind",
              "identity",
              "exact_jp"
            ],
            "type": "object"
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "description": "Finite Core literal identity and optional typed OptionPopup area anchor; metadata key is never Master lookup authority.",
            "properties": {
              "family": {
                "const": "core-literal-v1"
              },
              "localizer_type": {
                "const": 0,
                "type": "integer"
              },
              "text_config_key": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "option_area": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "enum": [
                      "soundAndTextOptionArea",
                      "screenSizeOptionArea",
                      "downloadOptionArea"
                    ]
                  },
                  "segments": {
                    "items": {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000-\\u001f\\u007f*?]+$",
                      "type": "string"
                    },
                    "maxItems": 16,
                    "minItems": 1,
                    "type": "array"
                  },
                  "indices": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    }
                  }
                },
                "required": [
                  "field",
                  "segments",
                  "indices"
                ]
              }
            },
            "required": [
              "family",
              "localizer_type",
              "text_config_key"
            ]
          }
        },
        "required": [
          "id",
          "resource_id",
          "adapter_id",
          "enabled",
          "source_identity",
          "selector"
        ],
        "type": "object"
      },
      "maxItems": 40000,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "bindings"
  ],
  "title": "GC UI bindings — NG01_V1",
  "type": "object"
}
