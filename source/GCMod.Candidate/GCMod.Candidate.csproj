<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-only candidate. Never imports the donor's GameDir output/copy targets. -->
  <Import Project="../build/Common.props" />
  <PropertyGroup>
    <AssemblyName>GCMod</AssemblyName>
    <RootNamespace>GCMod</RootNamespace>
    <Product>GCMod NG05 offline operator-ready candidate</Product>
    <Version>7.0.0</Version>
    <InformationalVersion>7.0.0-ng05-offline-operator-ready</InformationalVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.Candidate.cs;Config.Candidate.cs;NativeRuntimeBridge.cs;MyPluginInfo.cs;Legacy/**/*.cs;Native/**/*.cs" />
    <Reference Include="Utility" HintPath="$(GameDependencyRoot)/BepInEx/plugins/GCMod/Utility.dll" Private="false" />
  </ItemGroup>
  <Import Project="../GCMod.Nextgen/GCMod.Nextgen.sources.props" />
</Project>
