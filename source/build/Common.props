<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GameDependencyRoot Condition="'$(GameDependencyRoot)' == ''">$(GC_GAME_DEPENDENCY_ROOT)</GameDependencyRoot>
  </PropertyGroup>
  <ItemGroup>
    <InteropDependencies Include="$(GameDependencyRoot)/BepInEx/interop/*.dll" />
    <Reference Include="@(InteropDependencies)" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(GameDependencyRoot)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(GameDependencyRoot)/BepInEx/core/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GameDependencyRoot)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GameDependencyRoot)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(GameDependencyRoot)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDependencyRoot)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(GameDependencyRoot)/BepInEx/core/MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(GameDependencyRoot)/BepInEx/core/MonoMod.Utils.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateReadOnlyDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameDependencyRoot)' == ''" Text="Set GameDependencyRoot to a read-only game reference root; no game start is performed." />
    <Error Condition="!Exists('$(GameDependencyRoot)/BepInEx/interop/Assembly-CSharp.dll')" Text="The existing read-only interop references are missing." />
  </Target>
</Project>
