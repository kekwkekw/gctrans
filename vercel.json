{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "archive/review/accepted/chapter12/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/archive/review/accepted/chapter12(?:/index\\.html)?/?",
      "dest": "/archive/review/accepted/chapter12/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app.js"
    }
  ]
}